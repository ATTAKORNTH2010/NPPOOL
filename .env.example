# Environment variables for NP Pool — names only, never real values.
# Local development: copy to .env.local (git-ignored) and fill in.
# Vercel: Project Settings → Environment Variables (see docs/runbook/01-vercel-neon-setup.md).

# --- Database (set automatically by the Neon integration on Vercel) ---
# Pooled connection, used by the app and the seed/admin scripts
DATABASE_URL=
# Direct connection, used by drizzle-kit migrations
DATABASE_URL_UNPOOLED=

# --- Better Auth ---
# Random value, at least 32 characters. Different per environment.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Public URL of the app. Leave unset on Vercel (derived from VERCEL_* variables)
# until a custom domain is added.
BETTER_AUTH_URL=http://localhost:3000

# --- First admin account (npm run admin:ensure, also part of vercel-build) ---
# Created only if the username does not exist yet. The password is never printed.
# Username: 3-30 of a-z 0-9 _ .  Password: 8-128 with upper, lower, digit and symbol.
ADMIN_USERNAME=
ADMIN_NAME=
ADMIN_PASSWORD=
